PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
PYTHON_SERVICE_URL=http://localhost:8000
# Set both values to provision the first administrator on API startup. Use a unique email
# and a password of at least 12 characters; public buyer/seller registration cannot create admins.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Safaricom Daraja STK Push. Use sandbox credentials while testing.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL of this API, for example https://your-domain.example
MPESA_CALLBACK_URL=
# Generate a unique random value of at least 32 characters.
MPESA_CALLBACK_TOKEN=
